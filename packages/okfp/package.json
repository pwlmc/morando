{
  "name": "okfp",
  "version": "0.0.1",
  "description": "Essential functional programming utils for TypeScript",
  "license": "MIT",
  "author": "pwlmc",
  "type": "module",
  "main": "dist/",
  "exports": {
    "./either": {
      "types": "./dist/either.d.mts",
      "default": "./dist/either.mjs"
    },
    "./option": {
      "types": "./dist/option.mts",
      "default": "./dist/option.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "build": "tsdown  --format esm --dts",
    "dev": "tsdown --format esm --dts --watch"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.16",
    "oxlint": "^1.35.0",
    "tsdown": "^0.18.3",
    "typescript": "^5.6.3",
    "vitest": "^4.0.16"
  }
}
