{
  "includes": ["src/**/*.{ts,tsx,js,jsx}"],
  "ignores": ["**/node_modules"],
  "layers": [
    "main",
    "pages",
    "components",
    "hooks",
    "behaviors",
    "definitions"
  ],
  "layerMatchers": [
    {
      "layer": "definitions",
      "pattern": "**/model.ts"
    },
    {
      "layer": "definitions",
      "pattern": "**/constants.ts"
    },
    {
      "layer": "pages",
      "pattern": "/**/*Page.tsx"
    },
    {
      "layer": "hooks",
      "pattern": "**/use[A-Z0-9]+.{ts,tsx}"
    },
    {
      "layer": "components",
      "pattern": "**/*.tsx"
    },
    {
      "layer": "main",
      "pattern": "**/Main/**/*.ts"
    },
    {
      "layer": "behaviors",
      "pattern": "**/*.ts"
    }
  ]
}
