{
  "includes": ["src/**/*.{ts,tsx,js,jsx}"],
  "ignores": ["**/node_modules"],
  "layers": [
    "main",
    "pages",
    "components",
    "hooks",
    "business",
    "defs"
  ],
  "layerMatchers": [
    {
      "layer": "defs",
      "pattern": "**/model.ts"
    },
    {
      "layer": "defs",
      "pattern": "**/constants.ts"
    },
    {
      "layer": "defs",
      "pattern": "**/defs.ts"
    },
    {
      "layer": "pages",
      "pattern": "/**/*Page.tsx"
    },
    {
      "layer": "hooks",
      "pattern": "**/use[A-Z0-9]+.{ts,tsx}"
    },
    {
      "layer": "components",
      "pattern": "**/*.tsx"
    },
    {
      "layer": "main",
      "pattern": "**/Main/**/*.ts"
    },
    {
      "layer": "business",
      "pattern": "**/*.ts"
    }
  ]
}
