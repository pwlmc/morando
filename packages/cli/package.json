{
  "name": "@morando/cli",
  "version": "0.0.0",
  "description": "Architecture linter for the JavaScript ecosystem.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "build": "tsdown src/index.ts --format esm --dts",
    "dev": "tsdown src/index.ts --format esm --watch"
  },
  "bin": {
    "morando": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pwlmc/morando.git"
  },
  "keywords": [
    "morando",
    "cli",
    "formatter",
    "validator",
    "linter",
    "architecture"
  ],
  "author": "pwlmc <pwlmaciejewski@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pwlmc/morando/issues"
  },
  "homepage": "https://github.com/pwlmc/morando#readme",
  "dependencies": {
    "ajv": "^6.12.6",
    "chalk": "^4.1.2",
    "okfp": "^0.0.1",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.33",
    "@vitest/coverage-v8": "^4.0.16",
    "oxlint": "^1.6.0",
    "tsdown": "^0.18.3",
    "typescript": "^5.6.3",
    "vitest": "^4.0.16"
  }
}
