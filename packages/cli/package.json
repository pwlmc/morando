{
  "name": "@morando/cli",
  "version": "0.0.0",
  "description": "Architecture linter for the JavaScript ecosystem.",
  "main": "dist/index.js",
  "scripts": {
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "build": "tsup src/index.ts --format cjs --dts --out-dir dist",
    "dev": "tsup src/index.ts --format cjs --watch"
  },
  "bin": {
    "morando": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pwlmc/morando.git"
  },
  "keywords": [
    "morando",
    "cli",
    "formatter",
    "validator",
    "linter",
    "architecture"
  ],
  "author": "pwlmc <pwlmaciejewski@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pwlmc/morando/issues"
  },
  "homepage": "https://github.com/pwlmc/morando#readme",
  "dependencies": {
    "cosmiconfig": "^9.0.0",
    "es-module-lexer": "^1.7.0",
    "globby": "^14.1.0",
    "node-fs-extra": "^0.8.2",
    "yargs": "^18.0.0",
    "zod": "^3.25.63"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.33",
    "oxlint": "^1.6.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.3"
  }
}
