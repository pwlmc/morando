{
  "extends": "./defaultConfig.jsonc",
  "layers": ["pages", "components", "hooks", "business", "utils", "model"],
  "defaultLayer": "business",
  "matchers": [
    {
      "layer": "pages",
      "matcher": "glob",
      "pattern": "/**/*Page.tsx"
    },
    {
      "layer": "components",
      "matcher": "glob",
      "pattern": "**/components/**/*.tsx"
    },
    {
      "layer": "hooks",
      "pattern": "**/use[A-Z]*.{ts,tsx}"
    },
    {
      "layer": "utils",
      "matcher": "glob",
      "pattern": "**/utils/**/[a-z]*.ts}"
    }
  ]
}
